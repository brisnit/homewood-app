{
  "expo": {
    "name": "Homewood Living Ministries",
    "slug": "homewood-living-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homewood",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1C3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.homewoodliving.ministries",
      "infoPlist": {
        "NSCameraUsageDescription": "Homewood Living uses the camera to scan friends' QR codes so you can connect.",
        "NSContactsUsageDescription": "Homewood Living can find friends already using the app from your contacts.",
        "NSPhotoLibraryUsageDescription": "Homewood Living lets you choose a profile photo from your library."
      }
    },
    "android": {
      "package": "org.homewoodliving.ministries",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1C3F"
      },
      "permissions": [
        "CAMERA",
        "READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Homewood Living uses the camera to scan friends' QR codes."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Homewood Living can find friends already using the app from your contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Homewood Living lets you choose a profile photo from your library."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fa955df9-ec53-4e33-9d29-7128080d4ebd"
      }
    },
    "owner": "artifact-digital"
  }
}
