# ─── Homewood Living Ministries — Environment ───────────────────────────────
# Copy to `.env` and fill in. The app runs fully on MOCK data if these are unset.

# Supabase (auth, database, storage, profiles). Leave blank to use the mock auth store.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Content providers. Options:
#   BIBLE_PROVIDER:      youversion | fallback | mock   (default: mock)
#   DEVOTIONAL_PROVIDER: youversion | homewood | mock   (default: mock)
EXPO_PUBLIC_BIBLE_PROVIDER=mock
EXPO_PUBLIC_DEVOTIONAL_PROVIDER=mock

# YouVersion Platform API.
# TODO(youversion): Confirm API access + licensing before enabling the youversion provider.
#   See https://developers.youversion.com / https://api.youversion.com — partner approval required.
EXPO_PUBLIC_YOUVERSION_API_KEY=

# Homewood devotional API (our own fallback content service), if hosted.
EXPO_PUBLIC_HOMEWOOD_API_URL=
